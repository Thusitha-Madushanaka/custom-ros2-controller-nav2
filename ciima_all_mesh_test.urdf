<?xml version="1.0"?>
<robot name="ciima_all_mesh_test">

  <!-- BASE -->
  <link name="fake_robot_base_link">
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="10.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0"
               iyy="0.5" iyz="0" izz="0.8"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="file:///home/thusitha_madushanaka/nav2_ws/src/ciima_description/meshes/base_link.STL"/>
      </geometry>
      <material name="chassis">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.80 0.50 0.30"/>
      </geometry>
    </collision>
  </link>

  <!-- FRONT STEERING LINK -->
  <link name="fake_robot_front_steer_link">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0"
               iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="file:///home/thusitha_madushanaka/nav2_ws/src/ciima_description/meshes/front_steer_link.STL"/>
      </geometry>
      <material name="front_steer">
        <color rgba="0.8 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="0.08 0.08 0.08"/></geometry>
    </collision>
  </link>

  <joint name="fake_robot_front_steer_joint" type="continuous">
    <parent link="fake_robot_base_link"/>
    <child link="fake_robot_front_steer_link"/>
    <origin xyz="0.36 0 0.0475" rpy="0 0 3.14159"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- FRONT WHEEL -->
  <link name="fake_robot_front_wheel_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///home/thusitha_madushanaka/nav2_ws/src/ciima_description/meshes/front_wheel_link.STL"/>
      </geometry>
      <material name="front_wheel">
        <color rgba="0.1 0.3 0.9 1"/>
      </material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.0725" length="0.04"/></geometry>
    </collision>
  </link>

  <joint name="fake_robot_front_wheel_joint" type="continuous">
    <parent link="fake_robot_front_steer_link"/>
    <child link="fake_robot_front_wheel_link"/>
    <origin xyz="0 0.025 0" rpy="1.5708 -0.57181 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- REAR STEERING LINK -->
  <link name="fake_robot_rear_steer_link">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0"
               iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="file:///home/thusitha_madushanaka/nav2_ws/src/ciima_description/meshes/rear_steer_link.STL"/>
      </geometry>
      <material name="rear_steer">
        <color rgba="0.2 0.7 0.3 1"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="0.08 0.08 0.08"/></geometry>
    </collision>
  </link>

  <joint name="fake_robot_rear_steer_joint" type="continuous">
    <parent link="fake_robot_base_link"/>
    <child link="fake_robot_rear_steer_link"/>
    <origin xyz="-0.36 0 0.0475" rpy="0 0 3.14159"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- REAR WHEEL -->
  <link name="fake_robot_rear_wheel_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///home/thusitha_madushanaka/nav2_ws/src/ciima_description/meshes/rear_wheel_link.STL"/>
      </geometry>
      <material name="rear_wheel">
        <color rgba="0.1 0.3 0.9 1"/>
      </material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.0725" length="0.04"/></geometry>
    </collision>
  </link>

  <joint name="fake_robot_rear_wheel_joint" type="continuous">
    <parent link="fake_robot_rear_steer_link"/>
    <child link="fake_robot_rear_wheel_link"/>
    <origin xyz="0 0.025 0" rpy="1.5708 0.56637 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- Simulated LiDAR link -->
  <link name="fake_robot_lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Mount the LiDAR above the robot base -->
  <joint name="fake_robot_lidar_joint" type="fixed">
    <parent link="fake_robot_base_link"/>
    <child link="fake_robot_lidar_link"/>
    <origin xyz="2.2 0 1.2" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Classic ray sensor -->
  <gazebo reference="fake_robot_lidar_link">
    <sensor name="lidar_sensor" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>fake_robot_lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
